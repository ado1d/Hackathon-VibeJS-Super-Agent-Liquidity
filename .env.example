# ============================================================
# Super Agent Liquidity Platform — Environment Configuration
# ============================================================
# Copy this file to .env and replace all placeholder values.
# DO NOT commit .env to git.
# ============================================================

# --- Application ---
APP_ENV=demo
# Set to "production" when deploying to Render/Railway/VPS.

# --- Database (PostgreSQL) ---
# Local Docker Compose: postgresql+psycopg://super_agent:CHANGE_ME@postgres:5432/super_agent
# Render: auto-injected when you link a Render Postgres database.
# Railway: auto-injected when you add a Railway Postgres service.
DATABASE_URL=postgresql+psycopg://super_agent:change-me@postgres:5432/super_agent
POSTGRES_DB=super_agent
POSTGRES_USER=super_agent
POSTGRES_PASSWORD=change-me

# --- Security ---
# Generate with: openssl rand -hex 32
# MUST be at least 32 characters. Never reuse across environments.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480

# --- CORS (Cross-Origin Resource Sharing) ---
# Comma-separated list of origins allowed to call the API.
# Include http://localhost:5173 for Vite dev, http://localhost for Docker Compose,
# and your production frontend URL (e.g. https://your-app.onrender.com).
# Use a single asterisk "*" to allow all origins (NOT recommended for production).
CORS_ORIGINS=http://localhost:5173,http://localhost

# --- Forecast Configuration ---
DEMO_SEED=20260711
SHORT_WINDOW_MINUTES=15
MEDIUM_WINDOW_MINUTES=60
FORECAST_HORIZON_MINUTES=360
PROVIDER_MIN_BUFFER_BDT=5000
CASH_MIN_BUFFER_BDT=10000
FRESH_AFTER_MINUTES=5
MISSING_AFTER_MINUTES=15
ANOMALY_CONFIG_PATH=app/services/anomaly_thresholds.yaml
ENABLE_ISOLATION_FOREST=true

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_TRUST_PROXY_HEADERS=true

# --- AI (OpenAI) ---
# Leave AI_ENABLED=false to run without OpenAI. The app works fully without AI.
# To enable: set AI_ENABLED=true and paste your OpenAI API key below.
AI_ENABLED=false
OPENAI_API_KEY=
# Cost/latency-oriented model used by the structured Responses API integration.
OPENAI_MODEL=gpt-5.4-mini
AI_MAX_OUTPUT_TOKENS=500
AI_TIMEOUT_SECONDS=12
AI_CACHE_TTL_MINUTES=60
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_PRICING_VERSION=unconfigured

# --- Validation Data ---
VALIDATION_DATA_DIR=/app/data/validation
COMMIT_IDENTIFIER=unknown

# --- Frontend (Vite build-time variables) ---
VITE_API_BASE=/api/v1
# Optional: set to a tile server URL to show a map on the agent detail page.
# Example: https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# --- Domain (optional, for deployment metadata) ---
DOMAIN=
