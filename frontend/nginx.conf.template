server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;

  location = /healthz { access_log off; return 200 "ok\n"; }

  # Proxy API calls to the backend.
  # 
  # Three things make this work on Render:
  # 1. resolver 1.1.1.1 8.8.8.8 — public DNS (Render containers don't have
  #    Docker's 127.0.0.11 internal DNS).
  # 2. set $backend_upstream + proxy_pass $backend_upstream — resolves at
  #    request time, so nginx doesn't crash at startup if BACKEND_URL is
  #    wrong.
  # 3. proxy_ssl_server_name on + proxy_ssl_name — sends SNI during the TLS
  #    handshake. Without this, Render's load balancer rejects the connection
  #    with "SSL alert number 40" because it doesn't know which backend to
  #    route to.
  #
  # The 15-extract-backend-host.sh script (runs before envsubst) strips the
  # trailing slash from BACKEND_URL and extracts BACKEND_HOST for SNI.
  location /api/ {
    resolver 1.1.1.1 8.8.8.8 valid=30s ipv6=off;
    set $backend_upstream "${BACKEND_URL}";
    proxy_ssl_server_name on;
    proxy_ssl_name "${BACKEND_HOST}";
    proxy_pass $backend_upstream/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;
    proxy_http_version 1.1;
  }

  # SPA fallback
  location / { try_files $uri $uri/ /index.html; }
}
