server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;

  location = /healthz { access_log off; return 200 "ok\n"; }

  # Proxy /api/ calls to the backend service.
  #
  # How this works on Render:
  #   1. resolver 1.1.1.1 8.8.8.8 — public DNS (Render has no Docker DNS).
  #   2. set $backend_upstream + proxy_pass $backend_upstream — defers DNS
  #      resolution to request time so nginx doesn't crash at startup.
  #   3. proxy_ssl_server_name on — nginx auto-sends SNI using the host
  #      portion of the proxy_pass URL. No need for proxy_ssl_name or a
  #      separate host-extraction script.
  #
  # IMPORTANT: Set BACKEND_URL WITHOUT a trailing slash, e.g.
  #   https://super-agent-backend-xxxx.onrender.com
  # (not https://super-agent-backend-xxxx.onrender.com/)
  location /api/ {
    resolver 1.1.1.1 8.8.8.8 valid=30s ipv6=off;
    set $backend_upstream "${BACKEND_URL}";
    proxy_ssl_server_name on;
    proxy_pass $backend_upstream/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;
    proxy_http_version 1.1;
  }

  # SPA fallback
  location / { try_files $uri $uri/ /index.html; }
}
