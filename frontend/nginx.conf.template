server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;

  location = /healthz { access_log off; return 200 "ok\n"; }

  # Proxy API calls to the backend.
  # We use a variable + resolver so nginx doesn't crash at startup if
  # BACKEND_URL doesn't resolve yet (e.g. on first Render deploy before
  # the env var is updated). Nginx resolves at request time instead.
  # 127.0.0.11 is Docker's embedded DNS; 1.1.1.1/8.8.8.8 are public fallbacks.
  location /api/ {
    resolver 127.0.0.11 1.1.1.1 8.8.8.8 valid=30s ipv6=off;
    set $backend_upstream "${BACKEND_URL}";
    proxy_pass $backend_upstream/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;
    # Allow HTTP/HTTPS upstreams without trailing slash
    proxy_http_version 1.1;
  }

  # SPA fallback
  location / { try_files $uri $uri/ /index.html; }
}
